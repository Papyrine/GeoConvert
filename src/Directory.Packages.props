<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AngleSharp" Version="1.7.1" />
    <PackageVersion Include="ProjectDefaults" Version="1.0.180" />
    <PackageVersion Include="SponsorCheck" Version="0.20.0" GitHubSponsorsAccount="Papyrine" SponsorOwner="Papyrine" CheckTransitiveReferences="true" SponsorLandingUrl="https://github.com/sponsors/Papyrine" />
    <SponsorExemption Include="MaintainerConsulting" Message="Organizations that have engaged any of the core maintainers of Papyrine in consulting work could be exempt from the Maintenance Fee for 6 months from the final date of that work." />
    <SponsorExemption Include="SmallRevenue" Message="Consumers under US$10,000 annual gross revenue are exempt." />
    <PackageVersion Include="Polyfill" Version="11.2.0" />
    <PackageVersion Include="System.IO.Hashing" Version="10.0.11" />
    <PackageVersion Include="SkiaSharp" Version="4.151.1" />
    <PackageVersion Include="SixLabors.ImageSharp" Version="4.1.1" />
    <PackageVersion Include="SixLabors.ImageSharp.Drawing" Version="3.1.0" />
    <PackageVersion Include="ProjectFiles" Version="1.4.0" />
    <PackageVersion Include="TUnit" Version="1.65.38" />
    <PackageVersion Include="MarkdownSnippets.MsBuild" Version="28.4.2" />
    <PackageVersion Include="Verify" Version="31.28.0" />
    <PackageVersion Include="Verify.TUnit" Version="31.28.0" />
    <PackageVersion Include="Verify.DiffPlex" Version="3.3.1" />
    <PackageVersion Include="Verify.WinForms" Version="6.0.0" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Parquet.Net" Version="6.1.0" />
    <PackageVersion Include="MapBundle" Version="1.0.1" />
    <PackageVersion Include="MapBundle.World" Version="1.0.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageVersion Include="bunit" Version="2.9.0" />
    <PackageVersion Include="Verify.Bunit" Version="14.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.62.0" />
    <PackageVersion Include="Verify.Playwright" Version="3.1.1" />
  </ItemGroup>
</Project>