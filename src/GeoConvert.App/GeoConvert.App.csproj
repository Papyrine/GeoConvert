<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <!--
    A WinForms GUI that is also shipped as a .NET tool. The packaging mirrors MsOfficeDiff
    (https://github.com/SimonCropp/MsOfficeDiff): the WindowsDesktop SDK gives us WinForms, and the two
    Target hacks below let the project keep a *plain* TFM (net10.0, no '-windows' suffix) so it
    packs as an ordinary framework-dependent dotnet tool. Unlike MsOfficeDiff this stays inside
    GeoConvert's no-third-party-dependency discipline: argument parsing is hand-rolled (see Cli.cs) and
    settings use System.Text.Json, so no CliFx / Serilog / DI packages are pulled in. The Skia and
    ImageSharp render backends are referenced for parity with the geoconvert CLI's renderer flag; those
    (and only those) carry third-party dependencies into the tool, exactly as the CLI already does.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CA1416;NETSDK1137</NoWarn>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>geoconvert-app</ToolCommandName>
    <RootNamespace>GeoConvert.App</RootNamespace>
    <RollForward>LatestMajor</RollForward>
    <!-- Match MsOfficeDiff's WinForms-tool template: a GUI tool ships no XML docs, and the tool's
         dependencies must be copied locally so the packed tool runs standalone. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Description>A WinForms desktop app and .NET tool that converts maps between geospatial formats, renders them to PNG/SVG, and diffs two maps. Built on GeoConvert.</Description>
    <PackageTags>geojson;shapefile;flatgeobuf;topojson;kml;kmz;gpx;wkt;wkb;gis;geospatial;conversion;winforms;diff</PackageTags>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="nuget-readme.md" Pack="true" PackagePath="\readme.md" Visible="false" />
  </ItemGroup>

  <Target Name="RemoveTargetPlatformIdentifier" BeforeTargets="_CheckForInvalidWindowsDesktopTargetingConfiguration">
    <PropertyGroup>
      <TargetPlatformIdentifier>Windows</TargetPlatformIdentifier>
    </PropertyGroup>
  </Target>
  <Target Name="RestoreTargetPlatformIdentifier" AfterTargets="_CheckForInvalidWindowsDesktopTargetingConfiguration">
    <PropertyGroup>
      <TargetPlatformIdentifier></TargetPlatformIdentifier>
    </PropertyGroup>
  </Target>

  <!--
    The shared TrimNativeSymbols target (Directory.Build.props) already strips the native .pdb symbols.
    This is additionally a Windows-only WinForms tool, so drop the non-Windows native libs too — they
    can never load here. Together with the shared symbol strip this keeps the nupkg to tens of MB
    (win-only libSkiaSharp), down from ~180 MB.
  -->
  <Target Name="TrimNonWindowsNativeAssets" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="$([System.String]::Copy('%(RelativePath)').Replace('\', '/').Contains('runtimes/osx')) or $([System.String]::Copy('%(RelativePath)').Replace('\', '/').Contains('runtimes/linux'))" />
    </ItemGroup>
  </Target>

  <!--
    Bundle the same sample world map the Blazor app uses: country borders, topology-simplified at
    tolerance 0.1. MapBundle stages the result as maps/World/borders.fgb beside the app at build time
    (its default "maps/<Region>" layout); the "Load sample map" menu item reads it at runtime. Same
    knobs as GeoConvert.Web.csproj, minus the wwwroot output override.
  -->
  <PropertyGroup>
    <MapBundleLayers>Borders</MapBundleLayers>
    <MapBundleSimplifyTolerance>0.1</MapBundleSimplifyTolerance>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MapBundle.World" PrivateAssets="all" />
    <ProjectReference Include="..\GeoConvert\GeoConvert.csproj" />
    <ProjectReference Include="..\GeoConvert.Skia\GeoConvert.Skia.csproj" />
    <ProjectReference Include="..\GeoConvert.ImageSharp\GeoConvert.ImageSharp.csproj" />
    <PackageReference Include="Polyfill" PrivateAssets="all" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <!-- The Forms and other UI types are internal; the test project (signed with the same src/key.snk)
         snapshots them via Verify.WinForms. Same public key as the library's IVT entries. -->
    <InternalsVisibleTo Include="GeoConvert.App.Tests" Key="" />
  </ItemGroup>

</Project>
