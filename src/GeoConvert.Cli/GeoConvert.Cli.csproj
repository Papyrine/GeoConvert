<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>geoconvert</ToolCommandName>
    <RootNamespace>GeoConvert.Cli</RootNamespace>
    <Description>Command line converter for map formats, built on GeoConvert.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GeoConvert\GeoConvert.csproj" />
    <!-- Alternative PNG render backends, surfaced via the renderer flag. These pull third-party
         dependencies (SkiaSharp, SixLabors.ImageSharp) into the tool; the core stays dependency-free. -->
    <ProjectReference Include="..\GeoConvert.Skia\GeoConvert.Skia.csproj" />
    <ProjectReference Include="..\GeoConvert.ImageSharp\GeoConvert.ImageSharp.csproj" />
    <PackageReference Include="Polyfill" PrivateAssets="all" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
  </ItemGroup>

</Project>
