<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <Description>Optional SixLabors.ImageSharp-backed PNG render backend for GeoConvert. Rasterizes the same projection, styling and labelling pipeline as the built-in renderer through ImageSharp. Unlike GeoConvert itself, this package takes a third-party dependency (SixLabors.ImageSharp, under the Six Labors Split License).</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="nuget-readme.md" Pack="true" PackagePath="\readme.md" Visible="false" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <PackageReference Include="SponsorCheck" PrivateAssets="all" />
    <ProjectReference Include="..\GeoConvert\GeoConvert.csproj" />
    <!-- ImageSharpSurface is internal, so its primitive contracts (transparent fill, empty ring,
         one-point chain) and the font-fallback ladder are only reachable from the tests through IVT.
         Signs with the same src/key.snk, so it shares the public key with GeoConvert's own
         InternalsVisibleTo entries. -->
    <InternalsVisibleTo Include="Tests" Key="" />
  </ItemGroup>

</Project>
