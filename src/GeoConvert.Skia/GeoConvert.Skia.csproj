<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
    <Description>Optional SkiaSharp-backed PNG render backend for GeoConvert. Rasterizes the same projection, styling and labelling pipeline as the built-in renderer through Skia. Unlike GeoConvert itself, this package takes a third-party dependency (SkiaSharp).</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="nuget-readme.md" Pack="true" PackagePath="\readme.md" Visible="false" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <!-- The library compiles GeoConvert's Polyfill copy in via InternalsVisibleTo, so this project must
         not reference Polyfill itself (a second copy causes ambiguous-extension build errors). -->
    <ProjectReference Include="..\GeoConvert\GeoConvert.csproj" />
  </ItemGroup>

</Project>
