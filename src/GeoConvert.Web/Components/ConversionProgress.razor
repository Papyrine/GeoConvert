@* A determinate-or-indeterminate progress bar for read/write/render operations. When the latest
   report carries a fraction it fills proportionally; otherwise it animates as an indeterminate bar.
   The detail line shows whichever counts the report carries: features (the total is known when
   writing/rendering) and bytes (the total is known when reading a seekable source). *@

<div class="progress" role="progressbar" aria-label="@(Label ?? "Working")">
    <div class="progress-track">
        @if (!Indeterminate && Report?.Fraction is { } fraction)
        {
            <div class="progress-fill" style="@($"width:{fraction * 100:0}%")"></div>
        }
        else
        {
            <div class="progress-fill progress-fill-indeterminate"></div>
        }
    </div>
    @if (Label is not null)
    {
        <div class="progress-label">
            <span>@Label</span>
            @if (Detail() is { } detail)
            {
                <span class="progress-count">@detail</span>
            }
        </div>
    }
</div>
