@* Shared render-settings editor for the image outputs (PNG, SVG). The format-specific tail — PNG
   compression / SVG simplify — is supplied by the wrapping editor via the FormatSpecific fragment, so
   this component owns only the knobs both formats share. Every visual change invokes OnChanged so the
   host can refresh the preview. *@

<div class="image-options">
    <div class="format-selector">
        <label for="projection-select">Map projection</label>
        <select id="projection-select" class="format-select" @bind="Settings.Projection" @bind:after="Changed">
            @foreach (var option in ExportOptionChoices.Projections)
            {
                <option value="@option.Value">@option.Label</option>
            }
        </select>
    </div>
    <div class="format-selector">
        <label for="max-dimension">Resolution</label>
        <select id="max-dimension" class="format-select" @bind="Settings.MaxDimension" @bind:after="Changed">
            @foreach (var option in ExportOptionChoices.Dimensions)
            {
                <option value="@option.Value">@option.Label</option>
            }
        </select>
    </div>
    <div class="format-selector label-toggle">
        <label for="show-labels">Labels</label>
        <input id="show-labels" type="checkbox" @bind="Settings.Labels" @bind:after="Changed" />
    </div>
</div>

@* All remaining RenderOptions knobs, tucked behind a native <details> so the default UI stays simple. *@
<details class="advanced-options">
    <summary>Advanced options</summary>
    <div class="advanced-grid">
        <section class="advanced-section">
            <h4>Size &amp; layout</h4>
            <div class="option-row">
                <label for="padding">Padding (px)</label>
                <input id="padding" type="number" min="0" max="200" @bind="Settings.Padding" @bind:after="Changed" />
            </div>
        </section>

        <section class="advanced-section">
            <h4>Strokes &amp; features</h4>
            <div class="option-row">
                <label for="stroke-width">Stroke width (px)</label>
                <input id="stroke-width" type="number" min="0" max="50" @bind="Settings.StrokeWidth" @bind:after="Changed" />
            </div>
            <div class="option-row">
                <label for="point-radius">Point radius (px)</label>
                <input id="point-radius" type="number" min="0" max="50" @bind="Settings.PointRadius" @bind:after="Changed" />
            </div>
            <div class="option-row option-row-inline">
                <label for="stroke-autoscale">Auto-scale strokes to zoom</label>
                <input id="stroke-autoscale" type="checkbox" @bind="Settings.StrokeAutoScale" @bind:after="Changed" />
            </div>
            <div class="option-row">
                <label for="min-feature">Min feature size (px)</label>
                <input id="min-feature" type="number" min="0" max="64" step="0.5" @bind="Settings.MinFeaturePixels" @bind:after="Changed" />
            </div>
            <div class="option-row">
                <label for="label-size">Label size (px)</label>
                <input id="label-size" type="number" min="1" max="200" step="0.5" @bind="Settings.LabelSize" @bind:after="Changed" />
            </div>
        </section>

        <section class="advanced-section">
            <h4>Colors</h4>
            <div class="option-row option-row-inline">
                <label for="background-color">Background</label>
                <input id="background-color" type="color" @bind="Settings.BackgroundHex" @bind:after="Changed" />
            </div>
            <div class="option-row option-row-inline">
                <label for="ocean-enabled">Ocean fill</label>
                <input id="ocean-enabled" type="checkbox" @bind="Settings.OceanEnabled" @bind:after="Changed" />
                <input type="color" @bind="Settings.OceanHex" @bind:after="Changed" disabled="@(!Settings.OceanEnabled)" />
                <input type="range" min="0" max="255" @bind="Settings.OceanOpacity" @bind:after="Changed" disabled="@(!Settings.OceanEnabled)" title="Opacity" />
            </div>
            <div class="option-row option-row-inline">
                <label for="stroke-color">Stroke</label>
                <input id="stroke-color" type="color" @bind="Settings.StrokeHex" @bind:after="Changed" />
            </div>
            <div class="option-row option-row-inline">
                <label for="fill-color">Polygon fill</label>
                <input id="fill-color" type="color" @bind="Settings.FillHex" @bind:after="Changed" />
                <input type="range" min="0" max="255" @bind="Settings.FillOpacity" @bind:after="Changed" title="Opacity" />
            </div>
            <div class="option-row option-row-inline">
                <label for="label-color">Label text</label>
                <input id="label-color" type="color" @bind="Settings.LabelColorHex" @bind:after="Changed" />
            </div>
            <div class="option-row option-row-inline">
                <label for="halo-enabled">Label halo</label>
                <input id="halo-enabled" type="checkbox" @bind="Settings.HaloEnabled" @bind:after="Changed" />
                <input type="color" @bind="Settings.LabelHaloHex" @bind:after="Changed" disabled="@(!Settings.HaloEnabled)" />
                <input type="range" min="0" max="255" @bind="Settings.LabelHaloOpacity" @bind:after="Changed" disabled="@(!Settings.HaloEnabled)" title="Opacity" />
            </div>
        </section>

        @FormatSpecific
    </div>
</details>

@code {
    [Parameter]
    public RenderSettings Settings { get; set; } = new();

    /// <summary>Raised after any knob changes, so the host can re-render the preview.</summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    /// <summary>The format's own section (PNG compression / SVG simplify), rendered last in the grid.</summary>
    [Parameter]
    public RenderFragment? FormatSpecific { get; set; }

    Task Changed() => OnChanged.InvokeAsync();
}
