<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <WasmEnableThreads>true</WasmEnableThreads>
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
    <UseNativeHttpHandler>true</UseNativeHttpHandler>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);BL0016</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="ILLink.Descriptors.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="MapBundle.World" PrivateAssets="all" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <ProjectReference Include="..\GeoConvert\GeoConvert.csproj" />
  </ItemGroup>

  <!--
    Bundle a sample world map as a static web asset, built at compile time from MapBundle.World.
    MapBundle ships the world layers as full-detail FlatGeobuf (borders alone is ~63 MB); the four
    MSBuild properties below drive its built-in pipeline to filter, simplify and stage the result:

      MapBundleLayers=Borders                    — drop every other layer (cities, rivers, …)
      MapBundleSimplifyTolerance=0.1             — Simplifier.SimplifyTopology in MapBundle 0.3.0+,
                                                    so adjacent country borders stay seamlessly
                                                    joined after thinning (no hairline gaps).
      MapBundleOutputDirectory=…\wwwroot\sample  — write the result straight into the source
                                                    wwwroot, where Blazor's default static-web-asset
                                                    glob picks it up automatically. The file lands
                                                    at wwwroot/sample/World/borders.fgb (the
                                                    <Region>/<filename>.<ext> layout MapBundle uses
                                                    under the output directory), served at
                                                    /sample/World/borders.fgb.

    No custom Target, no Exec, no Copy — MapBundle does the work, the consumer just points it.
    The result is downloaded on demand when the user clicks "View sample world map", never at app
    startup. FlatGeobuf is kept (binary, far smaller than GeoJSON) and ConversionService reads it.
  -->
  <PropertyGroup>
    <MapBundleLayers>Borders</MapBundleLayers>
    <MapBundleSimplifyTolerance>0.1</MapBundleSimplifyTolerance>
    <MapBundleOutputDirectory>$(MSBuildProjectDirectory)\wwwroot\sample</MapBundleOutputDirectory>
  </PropertyGroup>

  <!--
    js/version.js: the version the footer shows (v2.1.0+b4bbab2), for index.html's loading screen, which
    has to show it before .NET is running — a page the browser kept from an earlier deploy is then plain
    to see. Written to obj and linked into wwwroot, so it is a static web asset like any other, in every
    build and publish, and nothing generated lands in the source tree. Rewriting index.html after publish
    instead would leave its .br/.gz beside it stale.
  -->
  <Target Name="WriteVersionScript"
          BeforeTargets="ResolveProjectStaticWebAssets"
          DependsOnTargets="InitializeSourceControlInformation">
    <PropertyGroup>
      <_GeoConvertShortSha>$(SourceRevisionId)</_GeoConvertShortSha>
      <_GeoConvertShortSha Condition="$(SourceRevisionId.Length) &gt; 7">$(SourceRevisionId.Substring(0, 7))</_GeoConvertShortSha>
      <_GeoConvertVersionText>v$(Version)</_GeoConvertVersionText>
      <_GeoConvertVersionText Condition="'$(_GeoConvertShortSha)' != ''">$(_GeoConvertVersionText)+$(_GeoConvertShortSha)</_GeoConvertVersionText>
      <_GeoConvertVersionScript>$(IntermediateOutputPath)version.js</_GeoConvertVersionScript>
    </PropertyGroup>
    <WriteLinesToFile File="$(_GeoConvertVersionScript)"
                      Lines="window.geoConvertVersion = '$(_GeoConvertVersionText)'%3B"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Content Include="$(_GeoConvertVersionScript)" Link="wwwroot\js\version.js" />
      <FileWrites Include="$(_GeoConvertVersionScript)" />
    </ItemGroup>
  </Target>

</Project>
