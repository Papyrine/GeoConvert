<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <WasmEnableThreads>true</WasmEnableThreads>
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
    <UseNativeHttpHandler>true</UseNativeHttpHandler>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="ILLink.Descriptors.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="MapBundle.World" PrivateAssets="all" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <ProjectReference Include="..\GeoConvert\GeoConvert.csproj" />
  </ItemGroup>

  <!--
    Bundle a sample world map as a static web asset, built at compile time from MapBundle.World.
    MapBundle ships the world layers as full-detail FlatGeobuf (borders alone is ~63 MB); MapBundle's
    own Douglas-Peucker pass would simplify each country independently, which leaves hairline gaps
    and alpha-stacked overlaps along shared borders at low render scales (the adjacent rings get
    chord-simplified differently and no longer line up). So we skip MapBundle's processing entirely
    (MapBundleCopyData=false, empty SimplifyTolerance) and run `geoconvert simplify-topology`
    against the raw FlatGeobuf — junction-aware simplification reduces each shared arc once, so
    adjacent country polygons stay seamlessly joined after thinning. The result lands at
    /sample/world.fgb (downloaded on demand when the user clicks "View sample world map", never at
    app startup). FlatGeobuf is kept (binary, far smaller than GeoJSON) and ConversionService
    already reads it.
  -->
  <PropertyGroup>
    <WorldSampleTolerance>0.1</WorldSampleTolerance>
    <MapBundleCopyData>false</MapBundleCopyData>
  </PropertyGroup>

  <!-- Only the country borders are wanted from the package's @(MapBundleData) item set. -->
  <Target Name="_KeepOnlyWorldBorders"
          BeforeTargets="_MapBundleConvert;_MapBundleCopyRaw;_SimplifyWorldSampleMap">
    <ItemGroup>
      <MapBundleData Remove="@(MapBundleData)" Condition="'%(Filename)' != 'borders'" />
    </ItemGroup>
  </Target>

  <!-- The default Content glob also matches the generated file (it's staged under wwwroot below); drop it
       here so the target is the single source of that Content item, avoiding NETSDK1022 duplicate-item
       errors on incremental builds where the file already exists at evaluation. -->
  <ItemGroup>
    <Content Remove="wwwroot\sample\world.fgb" />
  </ItemGroup>

  <!--
    Topology-aware simplification of the raw borders.fgb into wwwroot. Inputs= the raw 63 MB file
    from the MapBundle package; Outputs= the simplified ~7 MB asset. MSBuild's up-to-date check on
    Inputs/Outputs means a no-op when the source and tolerance haven't changed. The Exec runs
    GeoConvert.Cli via `dotnet run` (the project is a sibling, so this is in-repo) — adds a few
    seconds the first time, instant once the CLI is built. Stage under wwwroot before
    ResolveProjectStaticWebAssets so DefineStaticWebAssets picks it up and serves it as
    /sample/world.fgb; the file MUST be physically under wwwroot (a linked file is copied on
    publish but the dev server records ContentRoot as wwwroot and serves empty bytes).
  -->
  <Target Name="_SimplifyWorldSampleMap"
          BeforeTargets="ResolveProjectStaticWebAssets;AssignTargetPaths"
          Inputs="@(MapBundleData);$(MSBuildProjectFullPath)"
          Outputs="$(MSBuildProjectDirectory)\wwwroot\sample\world.fgb">
    <MakeDir Directories="$(MSBuildProjectDirectory)\wwwroot\sample" />
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)..\GeoConvert.Cli\GeoConvert.Cli.csproj&quot; -f net11.0 -c $(Configuration) -- &quot;%(MapBundleData.FullPath)&quot; &quot;$(MSBuildProjectDirectory)\wwwroot\sample\world.fgb&quot; --simplify $(WorldSampleTolerance) --simplify-topology"
          WorkingDirectory="$(MSBuildProjectDirectory)" />
    <ItemGroup>
      <Content Include="wwwroot\sample\world.fgb" />
    </ItemGroup>
  </Target>

</Project>
