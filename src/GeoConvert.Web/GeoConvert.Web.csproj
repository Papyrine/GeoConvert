<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <WasmEnableThreads>true</WasmEnableThreads>
    <BlazorEnableTimeZoneSupport>false</BlazorEnableTimeZoneSupport>
    <UseNativeHttpHandler>true</UseNativeHttpHandler>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="ILLink.Descriptors.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="MapBundle.World" PrivateAssets="all" />
    <PackageReference Include="ProjectDefaults" PrivateAssets="all" />
    <ProjectReference Include="..\GeoConvert\GeoConvert.csproj" />
  </ItemGroup>

  <!--
    Bundle a sample world map as a static web asset, generated at build time from MapBundle.World.
    MapBundle ships the world layers as full-detail FlatGeobuf (borders alone is ~63 MB); we run its
    GeoConvert-backed convert task with a Douglas-Peucker tolerance to shrink the geometry to a
    web-friendly size, then serve the result at /sample/world.fgb (read on demand when the user clicks
    "View sample world map" — only downloaded then, never at app startup). FlatGeobuf is kept (binary,
    far smaller than GeoJSON) and the app already reads it via ConversionService.
  -->
  <PropertyGroup>
    <MapBundleSimplifyTolerance>0.1</MapBundleSimplifyTolerance>
    <MapBundleSimplifyMethod>DouglasPeucker</MapBundleSimplifyMethod>
  </PropertyGroup>

  <!-- Only the country borders are wanted; drop the other layers (and meta.json) before conversion so
       the build doesn't simplify ~200 MB of data we never bundle. -->
  <Target Name="_KeepOnlyWorldBorders"
          BeforeTargets="_MapBundleConvert;_MapBundleCopyRaw">
    <ItemGroup>
      <MapBundleData Remove="@(MapBundleData)" Condition="'%(Filename)' != 'borders'" />
    </ItemGroup>
  </Target>

  <!-- MapBundle's convert task only re-runs when the source DATA changes, not when its embedded GeoConvert
       does — so upgrading MapBundle (e.g. to pick up a simplifier fix that yields a smaller map from the
       same data) otherwise leaves the previously staged output untouched. The task assembly's path carries
       the package version; when it differs from the last run, wipe the intermediate so the convert below
       regenerates. A clean build with the same version still skips, keeping the incremental loop fast. -->
  <Target Name="_InvalidateStaleSampleMap" BeforeTargets="_MapBundleConvert">
    <PropertyGroup>
      <_MapBundleStamp>$(MapBundleIntermediateDir)tasks.stamp</_MapBundleStamp>
      <_MapBundleStampValue Condition="Exists('$(_MapBundleStamp)')">$([System.IO.File]::ReadAllText('$(_MapBundleStamp)').Trim())</_MapBundleStampValue>
    </PropertyGroup>
    <RemoveDir Condition="'$(_MapBundleStampValue)' != '$(_MapBundleTasksAssembly)'"
               Directories="$(MapBundleIntermediateDir)" />
    <MakeDir Directories="$(MapBundleIntermediateDir)" />
    <WriteLinesToFile File="$(_MapBundleStamp)" Lines="$(_MapBundleTasksAssembly)" Overwrite="true" />
  </Target>

  <!-- The default Content glob also matches the generated file (it's staged under wwwroot below); drop it
       here so the target is the single source of that Content item, avoiding NETSDK1022 duplicate-item
       errors on incremental builds where the file already exists at evaluation. -->
  <ItemGroup>
    <Content Remove="wwwroot\sample\world.fgb" />
  </ItemGroup>

  <!-- _MapBundleConvert (BeforeTargets=AssignTargetPaths) writes the simplified borders.fgb into the
       intermediate dir and surfaces it as @(_MapBundleConverted). Stage it physically under wwwroot and
       register it as Content so ResolveProjectStaticWebAssets (also BeforeTargets=AssignTargetPaths)
       serves it at /sample/world.fgb. It MUST live under wwwroot, not just be linked there: a linked file
       outside wwwroot publishes fine (it's copied) but the dev server records its ContentRoot as wwwroot
       while the bytes sit in obj, so a GET returns 200 with an empty body. -->
  <Target Name="_BundleWorldSampleMap"
          AfterTargets="_MapBundleConvert"
          BeforeTargets="ResolveProjectStaticWebAssets"
          Condition="'@(_MapBundleConverted)' != ''">
    <Copy SourceFiles="@(_MapBundleConverted->WithMetadataValue('Filename', 'borders'))"
          DestinationFiles="$(MSBuildProjectDirectory)\wwwroot\sample\world.fgb"
          SkipUnchangedFiles="true" />
    <!-- Relative path under wwwroot so DefineStaticWebAssets' RelativePathPattern="wwwroot/**" matches it
         and resolves ContentRoot to the real wwwroot (an absolute include doesn't match the pattern). -->
    <ItemGroup>
      <Content Include="wwwroot\sample\world.fgb" />
    </ItemGroup>
  </Target>

</Project>
