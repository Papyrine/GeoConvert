@page "/"
@inject FileDownloadService FileDownloadService
@inject HttpClient Http
@inject IJSRuntime JsRuntime

<PageTitle>GeoConvert — Map Format Converter</PageTitle>

<div class="converter">
    <div class="upload-panel">
        <label class="file-drop" for="map-file">
            <span class="file-drop-icon">🗺️</span>
            <span class="file-drop-text">
                @if (sourceName is null)
                {
                    <strong>Choose a map file</strong>
                    <span>GeoJSON, TopoJSON, FlatGeobuf, KML, KMZ, GPX, WKT, WKB, CSV or GeoParquet</span>
                }
                else
                {
                    <strong>@sourceName</strong>
                    <span>@sourceFormat?.DisplayName · @featureCount feature@(featureCount == 1 ? "" : "s")</span>
                }
            </span>
            <InputFile id="map-file" OnChange="OnFileSelected" class="file-input" accept="@ConversionService.ReadableAccept" />
        </label>

        <div class="upload-or"><span>or</span></div>

        @* Loads a world map bundled at build time from MapBundle.World (country borders, Douglas–Peucker
           simplified) — fetched on demand so it only downloads when asked, never at app startup. *@
        <button class="sample-btn" @onclick="LoadSampleWorldMap" disabled="@isBusy">
            🌍 View sample world map
        </button>
    </div>

    @if (errorMessage is not null)
    {
        <ErrorPanel Message="@errorMessage" IssueUrl="@issueUrl" />
    }

    @* The read phase happens before the convert panel exists, so its progress shows here. The render
       preview shows its bar in the preview slot, and the download (write/render) shows its bar under the
       Download button — each next to the action that triggered it. Both reading and the sample map's
       network download are indeterminate: an uploaded file is already in memory, so its byte fraction
       would hit 100% instantly and freeze through the parse; and for the download the server's
       Content-Length is the *compressed* over-the-wire size (Blazor's static assets ship pre-Brotli'd),
       while the bytes the WASM HttpClient yields are the *decompressed* payload, so a ratio of the two
       overshoots 100% (a ~1.9 MB compressed FGB decodes to ~7 MB raw). The bar animates and the detail
       line shows decompressed bytes received so far — honest, even if not determinate. *@
    @if (isBusy && !isRendering && features is null)
    {
        <ConversionProgress Label="@progressLabel" Report="progressReport" Indeterminate="true" />
    }

    @if (features is not null)
    {
        @if (isRendering || previewDataUrl is not null)
        {
            <div class="preview">
                @if (isRendering)
                {
                    <div class="preview-busy">
                        <ConversionProgress Label="@progressLabel" Report="progressReport" />
                    </div>
                }
                else
                {
                    <img src="@previewDataUrl" alt="Rendered preview of the uploaded map" />
                }
            </div>
        }

        @if (previewDataUrl is not null)
        {
            <div class="image-options">
                <div class="format-selector">
                    <label for="projection-select">Map projection</label>
                    <select id="projection-select" class="format-select" @bind="settings.Projection" @bind:after="RefreshPreviewAsync">
                        @foreach (var option in Projections)
                        {
                            <option value="@option.Value">@option.Label</option>
                        }
                    </select>
                </div>
                <div class="format-selector">
                    <label for="max-dimension">Resolution</label>
                    <select id="max-dimension" class="format-select" @bind="settings.MaxDimension" @bind:after="RefreshPreviewAsync">
                        @foreach (var option in Dimensions)
                        {
                            <option value="@option.Value">@option.Label</option>
                        }
                    </select>
                </div>
                <div class="format-selector label-toggle">
                    <label for="show-labels">Labels</label>
                    <input id="show-labels" type="checkbox" @bind="settings.Labels" @bind:after="RefreshPreviewAsync" />
                </div>
            </div>

            @* All remaining RenderOptions knobs, tucked behind a native <details> so the default UI stays
               simple. Visual knobs refresh the preview (@bind:after); the format-specific ones at the
               bottom (PNG compression, SVG simplify) don't change the PNG preview, so they apply only at
               download and skip the refresh. *@
            <details class="advanced-options">
                <summary>Advanced options</summary>
                <div class="advanced-grid">
                    <section class="advanced-section">
                        <h4>Size &amp; layout</h4>
                        <div class="option-row">
                            <label for="padding">Padding (px)</label>
                            <input id="padding" type="number" min="0" max="200" @bind="settings.Padding" @bind:after="RefreshPreviewAsync" />
                        </div>
                    </section>

                    <section class="advanced-section">
                        <h4>Strokes &amp; features</h4>
                        <div class="option-row">
                            <label for="stroke-width">Stroke width (px)</label>
                            <input id="stroke-width" type="number" min="0" max="50" @bind="settings.StrokeWidth" @bind:after="RefreshPreviewAsync" />
                        </div>
                        <div class="option-row">
                            <label for="point-radius">Point radius (px)</label>
                            <input id="point-radius" type="number" min="0" max="50" @bind="settings.PointRadius" @bind:after="RefreshPreviewAsync" />
                        </div>
                        <div class="option-row option-row-inline">
                            <label for="stroke-autoscale">Auto-scale strokes to zoom</label>
                            <input id="stroke-autoscale" type="checkbox" @bind="settings.StrokeAutoScale" @bind:after="RefreshPreviewAsync" />
                        </div>
                        <div class="option-row">
                            <label for="min-feature">Min feature size (px)</label>
                            <input id="min-feature" type="number" min="0" max="64" step="0.5" @bind="settings.MinFeaturePixels" @bind:after="RefreshPreviewAsync" />
                        </div>
                        <div class="option-row">
                            <label for="label-size">Label size (px)</label>
                            <input id="label-size" type="number" min="1" max="200" step="0.5" @bind="settings.LabelSize" @bind:after="RefreshPreviewAsync" />
                        </div>
                    </section>

                    <section class="advanced-section">
                        <h4>Colors</h4>
                        <div class="option-row option-row-inline">
                            <label for="background-color">Background</label>
                            <input id="background-color" type="color" @bind="settings.BackgroundHex" @bind:after="RefreshPreviewAsync" />
                        </div>
                        <div class="option-row option-row-inline">
                            <label for="ocean-enabled">Ocean fill</label>
                            <input id="ocean-enabled" type="checkbox" @bind="settings.OceanEnabled" @bind:after="RefreshPreviewAsync" />
                            <input type="color" @bind="settings.OceanHex" @bind:after="RefreshPreviewAsync" disabled="@(!settings.OceanEnabled)" />
                            <input type="range" min="0" max="255" @bind="settings.OceanOpacity" @bind:after="RefreshPreviewAsync" disabled="@(!settings.OceanEnabled)" title="Opacity" />
                        </div>
                        <div class="option-row option-row-inline">
                            <label for="stroke-color">Stroke</label>
                            <input id="stroke-color" type="color" @bind="settings.StrokeHex" @bind:after="RefreshPreviewAsync" />
                        </div>
                        <div class="option-row option-row-inline">
                            <label for="fill-color">Polygon fill</label>
                            <input id="fill-color" type="color" @bind="settings.FillHex" @bind:after="RefreshPreviewAsync" />
                            <input type="range" min="0" max="255" @bind="settings.FillOpacity" @bind:after="RefreshPreviewAsync" title="Opacity" />
                        </div>
                        <div class="option-row option-row-inline">
                            <label for="label-color">Label text</label>
                            <input id="label-color" type="color" @bind="settings.LabelColorHex" @bind:after="RefreshPreviewAsync" />
                        </div>
                        <div class="option-row option-row-inline">
                            <label for="halo-enabled">Label halo</label>
                            <input id="halo-enabled" type="checkbox" @bind="settings.HaloEnabled" @bind:after="RefreshPreviewAsync" />
                            <input type="color" @bind="settings.LabelHaloHex" @bind:after="RefreshPreviewAsync" disabled="@(!settings.HaloEnabled)" />
                            <input type="range" min="0" max="255" @bind="settings.LabelHaloOpacity" @bind:after="RefreshPreviewAsync" disabled="@(!settings.HaloEnabled)" title="Opacity" />
                        </div>
                    </section>

                    <section class="advanced-section">
                        <h4>Format-specific</h4>
                        <div class="option-row">
                            <label for="png-compression">PNG compression</label>
                            <select id="png-compression" class="format-select" @bind="settings.PngCompression">
                                @foreach (var option in CompressionLevels)
                                {
                                    <option value="@option.Value">@option.Label</option>
                                }
                            </select>
                        </div>
                        <div class="option-row">
                            <label for="svg-simplify">SVG simplify (px)</label>
                            <input id="svg-simplify" type="number" min="0" max="20" step="0.1" @bind="settings.SvgSimplifyTolerance" />
                        </div>
                    </section>
                </div>
            </details>
        }

        <div class="convert-panel">
            <FormatSelector Label="Convert to"
                            Formats="ConversionService.WritableFormats"
                            Selected="target"
                            SelectedChanged="OnTargetChanged" />
            <button class="convert-btn" @onclick="Download" disabled="@(features.Count == 0 || isBusy)">
                @if (isBusy)
                {
                    <span class="btn-spinner"></span>
                }
                Download @TargetInfo?.DisplayName
            </button>
        </div>

        @* Clicking Download runs the actual conversion (write, or render for PNG/SVG) on a background
           thread; show its live progress right under the button. !isRendering excludes the preview
           render, which has its own bar above. *@
        @if (isBusy && !isRendering)
        {
            <ConversionProgress Label="@progressLabel" Report="progressReport" />
        }
    }
</div>
