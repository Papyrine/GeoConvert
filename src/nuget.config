<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Local sibling-repo MapBundle feed: lets GeoConvert.Web consume a pre-release MapBundle build
         before it's published. Remove this entry once the consumed MapBundle version is on nuget.org. -->
    <add key="mapbundle-local" value="..\..\MapBundle\nugets" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!-- Pin MapBundle (the core, transitively pulled by MapBundle.World) to the local feed only —
       otherwise NuGet sees the same 0.3.1 in both feeds and can pick nondeterministically once it's
       published, missing the in-progress targets changes that motivated the local pre-release. Other
       MapBundle.* (the data packages MapBundle.World, MapBundle.Europe, …) keep coming from nuget.org. -->
  <packageSourceMapping>
    <packageSource key="mapbundle-local">
      <package pattern="MapBundle" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
